browser:
  ab_bin: "$HOME/.nvm/versions/node/vXX/bin/agent-browser"
  session: "your-session-name"
  state_file: "profiles/your-state.json"

akamai_url: "https://control.akamai.com/apps/reports/"

# Optional: 1Password auto-login for Akamai via the `op` CLI.
# Values are item/account *references*, not secrets — the password and TOTP
# are read at runtime by `op`. Set enabled: false (or omit this section) to
# always use manual browser login instead.
onepassword:
  enabled: false
  account: "YOUR_OP_ACCOUNT_ID_OR_EMAIL"
  item: "YOUR_OP_ITEM_ID_OR_TITLE"

report_types:
  # Hostname report types — each runs on "Traffic by Hostname" page
  # Key names are user-defined; "geography" is reserved for geo reports.
  # The weekly CSV writer (scripts/csv_writer.py) recognises these keys:
  #   summary, v3, trailer, tva, live, home, geography
  summary:
    label: "Summary"
    cp_codes: ["ALL"]
    unit: "TB"
  v3:
    label: "v3"
    cp_codes: ["111111", "222222"]
    unit: "TB"
  trailer:
    label: "Trailer/EPK"
    cp_codes: ["333333"]
    unit: "TB"
  tva:
    label: "TVA"
    cp_codes: ["444444", "555555"]
    unit: "GB"
  live:
    label: "Live"
    cp_codes: ["666666"]
    unit: "GB"
  home:
    label: "Home"
    cp_codes: ["777777", "888888"]
    unit: "GB"
  # geography is a reserved key — runs on "Traffic by Geography" page
  geography:
    label: "Geography Report"
    cp_codes: ["ALL"]
    unit: "TB"
    # ISO 3166-1 alpha-2 country codes
    geo_countries: ["US", "JP", "KR"]

cloudfront:
  distribution_id: "YOUR_DISTRIBUTION_ID"
  region: "us-east-1"
  metric_name: "BytesDownloaded"
